{
  "name": "hors-champ-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prebuild": "node scripts/build-images.mjs",
    "redaction:proposer": "tsx --tsconfig tsconfig.json scripts/redaction/proposer.ts",
    "redaction:relire": "tsx --tsconfig tsconfig.json scripts/redaction/relire.ts",
    "redaction:accepter": "tsx --tsconfig tsconfig.json scripts/redaction/accepter.ts",
    "redaction:droits": "tsx --tsconfig tsconfig.json scripts/redaction/extraire-droits.ts",
    "redaction:droits-site": "tsx --tsconfig tsconfig.json scripts/redaction/droits-vers-site.ts",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "d3-geo": "^3.1.1",
    "graphql": "^16.14.2",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.0",
    "payload": "^3.91.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serve": "14.2.4",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
